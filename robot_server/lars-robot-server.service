[Unit]
Description=LARS Robot Server (API + Camera Daemon)
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User={{SERVICE_USER}}
Group={{SERVICE_USER}}
WorkingDirectory={{INSTALL_DIR}}
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH={{INSTALL_DIR}}/services/api/src
Environment=GPIOZERO_PIN_FACTORY=lgpio

# Start: run install.py which handles docker compose
# First build images (no compose up), then run compose with platform detection
ExecStartPre={{PYTHON_BIN}} {{INSTALL_DIR}}/scripts/install.py --tag dev --write-env --no-up
ExecStart={{PYTHON_BIN}} {{INSTALL_DIR}}/scripts/install.py --tag dev --compose-only
ExecStop={{PYTHON_BIN}} {{INSTALL_DIR}}/scripts/install.py --tag dev --down || /usr/bin/docker compose -f {{INSTALL_DIR}}/compose.yml down

# Restart policy
Restart=on-failure
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal

# Shutdown behavior
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target