[Unit]
Description=LARS Robot Server (API + Camera Daemon + Motion Daemon)
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
User={{SERVICE_USER}}
Group={{SERVICE_USER}}
WorkingDirectory={{INSTALL_DIR}}
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH={{INSTALL_DIR}}/services/api/src
Environment=GPIOZERO_PIN_FACTORY=lgpio
Environment=API_TAG=dev
# Load robot type from env file (written by unpack.py)
EnvironmentFile=/etc/lars/robot.env

# Start all services (using run_dev_win.py script)
ExecStart=/usr/bin/python3 {{INSTALL_DIR}}/scripts/run_dev_win.py up

# Stop all services (using run_dev_win.py script)
ExecStop=/usr/bin/python3 {{INSTALL_DIR}}/scripts/run_dev_win.py down

Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# Shutdown behavior
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target