[Unit]
Description=LARS Robot Server (API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=
Group=
# Working directory for the API; repository is installed into /home/<user>/LARS
WorkingDirectory=/home//LARS
# Ensure the API package (services/api/src) is importable
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home//LARS/services/api/src
Environment=GPIOZERO_PIN_FACTORY=lgpio

# Run installer before starting the API (keeps existing behavior)
ExecStartPre=/home//venv/bin/python /home//LARS/scripts/install.py --tag dev --write-env

# Start the API web server directly from the venv (uvicorn)
ExecStart=/home//venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000

Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal
KillMode=mixed
KillSignal=SIGINT
TimeoutStopSec=5

[Install]
WantedBy=default.target
